<Window x:Class="PcRemote.App.RemoteWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PC Remote · 远程桌面" Width="1200" Height="800" MinWidth="640" MinHeight="480"
 PreviewKeyDown="OnKeyDown" PreviewKeyUp="OnKeyUp">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="16,10">
   <Button DockPanel.Dock="Right" Content="断开连接" Click="DisconnectClick" Padding="16,8"/>
   <StackPanel>
    <TextBlock x:Name="DeviceText" FontSize="17" FontWeight="SemiBold"/>
    <TextBlock x:Name="StatusText" Text="正在连接…" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Row="1" Background="#101318" ClipToBounds="True">
   <Image x:Name="ScreenImage" Stretch="Uniform" Focusable="True" InputMethod.IsInputMethodEnabled="False" AutomationProperties.Name="远程屏幕"
          MouseMove="OnMouseMove" MouseDown="OnMouseDown" MouseUp="OnMouseUp" MouseWheel="OnMouseWheel"/>
   <TextBlock x:Name="Overlay" Foreground="White" Text="正在等待远程画面…" FontSize="20" TextWrapping="Wrap"
              MaxWidth="640" TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"/>
  </Grid>
 </Grid>
</Window>
