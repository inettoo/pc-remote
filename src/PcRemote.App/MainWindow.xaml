<Window x:Class="PcRemote.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PC Remote" Width="1080" Height="720" MinWidth="900" MinHeight="620"
 FontFamily="Segoe UI Variable, Microsoft YaHei UI" FontSize="14">
 <Grid Margin="28">
  <Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Margin="0,0,28,0">
   <StackPanel DockPanel.Dock="Top">
    <TextBlock Text="PC Remote" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,8"/>
    <TextBlock Text="让连接，保持简单。" Opacity="0.65"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
    <TextBlock Text="仅限局域网 · 无需账号" Margin="0,0,0,8"/>
    <TextBlock Text="{Binding Version}" Opacity="0.65"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,24">
    <TextBlock Text="你的工作空间" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding Status}" Margin="0,8,0,0" Opacity="0.65"/>
   </StackPanel>
   <Border Grid.Row="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" BorderThickness="1" CornerRadius="8" Padding="20" Margin="0,0,0,20">
    <StackPanel><TextBlock Text="连接始终由你掌控" FontSize="16" FontWeight="SemiBold"/>
     <TextBlock Text="本机启用并配置访问密钥后，连接无需逐次确认。查看、键鼠与文件使用预设权限，可随时断开。" Margin="0,8,0,0" Opacity="0.7"/>
    </StackPanel>
   </Border>
   <TabControl Grid.Row="2" AutomationProperties.Name="工作空间页面">
    <TabItem Header="局域网设备">
     <StackPanel VerticalAlignment="Center" Margin="32">
      <TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Text="{Binding EmptyDescription}" Margin="0,12,0,24" Opacity="0.7"/>
      <Button Content="发现设备 · 即将提供" IsEnabled="False" HorizontalAlignment="Left" ToolTip="v0.0.2 提供设备发现"/>
     </StackPanel>
    </TabItem>
    <TabItem Header="开发路线">
     <StackPanel Margin="24"><TextBlock Text="一步一步，连接起来" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Margin="0,16,0,0" Text="0.0.2  局域网发现&#10;&#10;0.0.3  加密连接与自动访问校验&#10;&#10;0.0.4–0.0.5  屏幕查看与键鼠控制&#10;&#10;0.0.6  文件管理&#10;&#10;0.0.7–0.1.0  稳定性、性能与预览发布"/>
     </StackPanel>
    </TabItem>
    <TabItem Header="设置与关于">
     <StackPanel Margin="24"><TextBlock Text="清晰的边界，更安心的连接" FontSize="22" FontWeight="SemiBold"/>
      <TextBlock Margin="0,16,0,0" Text="当前版本没有后台服务、自动启动、网络监听或防火墙修改。&#10;&#10;网卡选择和共享目录设置将在对应功能完成后开放。&#10;&#10;产品 0.0.1 · 协议 1.0"/>
     </StackPanel>
    </TabItem>
   </TabControl>
   <TextBlock Grid.Row="3" Text="Foundation 预览 · 远程连接功能尚未实现" Margin="0,20,0,0" Opacity="0.65"/>
  </Grid>
 </Grid>
</Window>
