<Window x:Class="PcRemote.App.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="PC Remote · 控制端" Width="1080" Height="720" MinWidth="900" MinHeight="620"
 FontFamily="Segoe UI Variable, Microsoft YaHei UI" FontSize="14">
 <Grid Margin="32">
  <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <DockPanel Margin="0,0,28,0">
   <StackPanel DockPanel.Dock="Top">
    <TextBlock Text="PC Remote" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="局域网，直接连接。" Margin="0,8,0,0" Opacity="0.65"/>
   </StackPanel>
   <StackPanel DockPanel.Dock="Bottom" VerticalAlignment="Bottom">
    <TextBlock Text="控制端" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding Version}" Margin="0,8,0,0" Opacity="0.6"/>
   </StackPanel>
  </DockPanel>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,24">
    <TextBlock Text="你的电脑，随时在手边" FontSize="28" FontWeight="SemiBold"/>
    <TextBlock Text="{Binding Status}" Margin="0,10,0,0" Opacity="0.7" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"/>
   </StackPanel>
   <Border Grid.Row="1" CornerRadius="8" Padding="20" Margin="0,0,0,24"
           BorderThickness="1" BorderBrush="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}">
    <StackPanel>
     <TextBlock Text="被控端只需运行一次" FontSize="17" FontWeight="SemiBold"/>
     <TextBlock Text="运行被控端 EXE，程序自动安装并启动服务。之后会在这里自动出现，无需选网卡、登录或逐次确认。" Margin="0,8,0,0" Opacity="0.7" TextWrapping="Wrap"/>
    </StackPanel>
   </Border>
   <Grid Grid.Row="2">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440">
     <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed"/>
      <Style.Triggers><DataTrigger Binding="{Binding Devices.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
     </Style></StackPanel.Style>
     <TextBlock Text="正在寻找你的被控电脑" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
     <TextBlock Text="保持两台电脑连接同一局域网，设备会自动显示在这里。" Margin="0,12,0,0" Opacity="0.65" TextAlignment="Center" TextWrapping="Wrap"/>
    </StackPanel>
    <ListBox ItemsSource="{Binding Devices}" BorderThickness="0" Background="Transparent" AutomationProperties.Name="可用的被控电脑">
     <ListBox.ItemTemplate><DataTemplate>
      <Grid Margin="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="18"/><TextBlock Text="{Binding Address}" Margin="0,6,0,0" Opacity="0.65"/></StackPanel>
       <Button Grid.Column="1" Content="控制" Click="ConnectClick" Margin="24,0,0,0" Padding="20,10"/>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
   <StackPanel Grid.Row="3" Margin="0,20,0,0">
    <TextBlock Text="{Binding Error}" TextWrapping="Wrap"/>
    <TextBlock Text="LAN 远控预览 · 单屏画面与键鼠 · 无账号、配对或逐次确认" Opacity="0.65" Margin="0,8,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Grid>
 </Grid>
</Window>
